---
import '../index.css'
import Footer from '../components/Footer.jsx'
import Nav from '../components/Nav.astro'
import WhatsAppButton from '../components/WhatsAppButton.jsx'
import { BASE_PATH, BUSINESS_NAME, SITE_URL } from '../site'
import { createPageSchema } from '../data/seo'

const {
  title,
  description,
  currentPage = 'home',
  noindex = false,
  schema = createPageSchema({ title, description, page: currentPage }),
} = Astro.props

const canonical = new URL(Astro.url.pathname, Astro.site).toString()
const socialImage = `${SITE_URL}/og-ramz-detailz.jpg`
const robots = noindex ? 'noindex,follow' : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1'
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={BUSINESS_NAME} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${BASE_PATH}favicon.svg`} />
    <link rel="sitemap" type="application/xml" href={`${BASE_PATH}sitemap-index.xml`} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content={`${BUSINESS_NAME} car detailing and mobile valeting in Coventry`} />
    <meta property="og:site_name" content={BUSINESS_NAME} />
    <meta property="og:locale" content="en_GB" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={`${BUSINESS_NAME} car detailing and mobile valeting in Coventry`} />

    <meta name="theme-color" content="#D4AF37" />
    <meta name="geo.region" content="GB-COV" />
    <meta name="geo.placename" content="Coventry" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Pinyon+Script&family=Bebas+Neue&family=DM+Sans:wght@300;400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap"
      rel="stylesheet"
      media="print"
      data-font-stylesheet
    />
    <script is:inline>
      window.addEventListener('load', () => {
        document.querySelector('[data-font-stylesheet]')?.setAttribute('media', 'all')
      })
    </script>
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Pinyon+Script&family=Bebas+Neue&family=DM+Sans:wght@300;400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap"
        rel="stylesheet"
      />
    </noscript>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <div class="min-h-screen overflow-x-hidden bg-black text-white">
      <Nav currentPage={currentPage} />
      <main id="main-content">
        <slot />
      </main>
      <Footer />
      <WhatsAppButton />
    </div>
  </body>
</html>
